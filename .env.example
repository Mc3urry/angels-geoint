# Copy to .env and fill in. .env is gitignored; this file is not.

# OpenSky Network -- https://opensky-network.org/
# Create an API client in your account settings. OAuth2 client credentials;
# basic auth with username/password is no longer accepted. Tokens last 30 min.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Global Fishing Watch -- https://globalfishingwatch.org/our-apis/tokens
# Free, non-commercial use only.
GFW_API_TOKEN=

# Copernicus Data Space -- https://dataspace.copernicus.eu
# Free registration, instant, no review queue. Needed only to DOWNLOAD
# Sentinel-1 scenes; searching the catalogue is anonymous.
# Use your .edu address if you have one.
CDSE_USERNAME=
CDSE_PASSWORD=

# aisstream.io -- https://aisstream.io
# Free, email registration only, no review queue. Real-time AIS over a
# WebSocket, filtered server-side by bounding box. Powers /live?domain=sea.
#
# This is the LIVE feed and it is cooperative reporting: every vessel on it
# chose to broadcast. It is a different source from the historical
# MarineCadastre store the matching pipeline uses, which is deliberate --
# the live map and the archive fail independently.
AISSTREAM_API_KEY=

# WMATA, for the road domain's independent layer over the study area.
# developer.wmata.com, free, Default Tier is 50,000 calls a day against the
# 2,880 a 30-second poll of one feed uses. Sent as an api_key HEADER, never
# as a query parameter: a credential in a url reaches the registry artefact,
# the probe manifest and every log.
WMATA_API_KEY=

# CARTO Basemaps, optional, for the 3D view's light basemap (Positron).
# carto.com/basemaps, free for academic use up to 5M requests a month. Added
# to tile requests by the API, never sent to the browser. Unset, the 3D view
# falls back to Esri's keyless light grey.
CARTO_BASEMAPS_KEY=

# ---------------------------------------------------------------------------
# THE 3D VIEW'S NATIONAL LAND LAYER. All optional, all free, all viewer only:
# no analysis reads any of these. Each one fills in a part of the US that is
# otherwise thinner. Keys are used by the API and never sent to the browser.
# ---------------------------------------------------------------------------

# Traffic cameras from each state's 511 developer API. Register on the site,
# then request a developer key from its developer page (/developers/doc).
# Without one, that state's cameras come from LiveTrafficCam (200 at most).
CAM_KEY_NY=   # https://511ny.org/developers/doc
CAM_KEY_GA=   # https://511ga.org/developers/doc
CAM_KEY_LA=   # https://511la.org/developers/doc  (request declined 2026-11-03; LA comes from LiveTrafficCam)
CAM_KEY_AZ=   # https://www.az511.com/developers/doc
CAM_KEY_WI=   # https://511wi.gov/developers/doc
CAM_KEY_ID=   # https://511.idaho.gov/developers/doc
CAM_KEY_UT=   # https://www.udottraffic.utah.gov/developers/doc
CAM_KEY_NV=   # https://www.nvroads.com/developers/doc
# CAM_KEY_CT is not used: CTroads' API has event feeds but no cameras
# (2026-11-02), so Connecticut comes from LiveTrafficCam.
CAM_KEY_NC=   # https://www.drivenc.gov/developers/doc
OHGO_API_KEY= # https://publicapi.ohgo.com/accounts/registration (Ohio)

# Transit systems that publish positions only behind a key.
API_511_ORG_KEY=      # https://511.org/open-data/token  (every Bay Area agency)
MTA_BUSTIME_KEY=      # https://register.developer.obanyc.com  (New York City buses)
CTA_TRAIN_KEY=        # https://www.transitchicago.com/developers/traintrackerapply  (Chicago L)
TRIMET_APP_ID=        # https://developer.trimet.org/appid/registration  (Portland)
OBA_PUGET_SOUND_KEY=  # email oba_api_key@soundtransit.org  (Sound Transit, Pierce, Everett, WSF)
METRA_API_TOKEN=      # https://metra.com/developers  (Chicago commuter rail)
SWIFTLY_API_KEY=      # https://www.goswift.ly/api-key-request  (LA Metro, SEPTA rail, MD MTA, ~55 agencies)

# Live road speeds on every road, aggregated by TomTom (no vehicle in it).
TOMTOM_API_KEY=       # https://developer.tomtom.com  (free: 50,000 tiles a day)

# Road events from the CARS hubs (Castle Rock Associates, by email request,
# 2026-11-06): one login for Indiana, Kansas, Minnesota and Nebraska (Iowa's
# hub redirects away). Sent as HTTP Basic over https to each hub only, and
# Kansas's own kscars.kandrive.gov; viewer only, not Phase G.
CARS_HUB_USER=
CARS_HUB_PASSWORD=
